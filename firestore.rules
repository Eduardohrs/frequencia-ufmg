rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasExactFields(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function hasValidAuditFields(data) {
      return data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt;
    }

    function preservesAuditFields() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt;
    }

    function hasValidConfiguration(data) {
      return data.lessonCount is int
        && data.lessonCount in [1, 2, 4]
        && data.callCount is int
        && data.callCount in [1, 2]
        && !(data.lessonCount == 1 && data.callCount == 2);
    }

    function isNullableString(value, maxLength) {
      return value == null
        || (value is string && value.size() <= maxLength);
    }

    function isValidOperationalLog(data) {
      let fields = [
        'schemaVersion',
        'occurredAt',
        'expiresAt',
        'level',
        'event',
        'entryPoint',
        'platform',
        'correlationId',
        'operation',
        'outcome',
        'durationMs',
        'screen',
        'action',
        'failureCode',
        'errorType',
        'errorCode',
        'errorMessage',
        'errorDetails',
        'fatal'
      ];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields.concat(['details']))
        && data.schemaVersion == 1
        && data.occurredAt is timestamp
        && data.occurredAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > data.occurredAt
        && data.expiresAt <= data.occurredAt + duration.value(31, 'd')
        && data.level in ['info', 'error']
        && data.event is string
        && data.event.size() >= 1
        && data.event.size() <= 80
        && data.entryPoint == 'client'
        && data.platform in ['web', 'android']
        && data.correlationId is string
        && data.correlationId.size() >= 1
        && data.correlationId.size() <= 128
        && isNullableString(data.operation, 80)
        && isNullableString(data.outcome, 24)
        && (data.durationMs == null
          || (data.durationMs is int && data.durationMs >= 0))
        && isNullableString(data.screen, 80)
        && isNullableString(data.action, 80)
        && isNullableString(data.failureCode, 120)
        && isNullableString(data.errorType, 120)
        && isNullableString(data.errorCode, 120)
        && isNullableString(data.errorMessage, 500)
        && isNullableString(data.errorDetails, 8192)
        && isNullableString(data.get('details', null), 8192)
        && data.fatal is bool;
    }

    function isValidCourse(data) {
      let legacyFields = [
        'schemaVersion',
        'code',
        'name',
        'workload',
        'term',
        'createdAt',
        'updatedAt'
      ];
      let datedFields = legacyFields.concat(['startsOn', 'endsOn']);
      let startsOn = data.get('startsOn', null);
      let endsOn = data.get('endsOn', null);
      let modality = data.get('modality', 'in_person');
      let policy = data.get('attendancePolicy', 'required');
      return (hasExactFields(data, legacyFields) || hasExactFields(data, datedFields)
          || hasExactFields(data, datedFields.concat(['modality', 'attendancePolicy'])))
        && modality in ['in_person', 'online']
        && policy in ['required', 'no_call']
        && (modality != 'online' || policy == 'no_call')
        && data.schemaVersion == 1
        && data.code is string
        && data.code.size() >= 1
        && data.code.size() <= 32
        && data.code.matches('^\\S(.*\\S)?$')
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 160
        && data.name.matches('^\\S(.*\\S)?$')
        && data.workload is int
        && data.workload > 0
        && data.term is string
        && data.term.matches('^[0-9]{4}-[12]$')
        && ((startsOn == null && endsOn == null)
          || (startsOn is timestamp && endsOn is timestamp && startsOn <= endsOn))
        && hasValidAuditFields(data);
    }

    function isValidMeeting(data) {
      let fields = [
        'schemaVersion',
        'weekday',
        'startMinutes',
        'endMinutes',
        'lessonCount',
        'callCount',
        'createdAt',
        'updatedAt'
      ];
      return hasExactFields(data, fields)
        && data.schemaVersion == 1
        && data.weekday is int
        && data.weekday >= 1
        && data.weekday <= 7
        && data.startMinutes is int
        && data.startMinutes >= 0
        && data.endMinutes is int
        && data.endMinutes <= 1440
        && data.startMinutes < data.endMinutes
        && hasValidConfiguration(data)
        && hasValidAuditFields(data);
    }

    function isValidPing(value) {
      return value == null
        || (value is string && value in ['no_campus', 'fora', 'indisponivel']);
    }

    function isValidAttendance(data) {
      let status = data.attendanceStatus;
      let unresolved = status == null || status == 'pendente';
      return (
          status == null
          || (status is string && status in [
            'presente',
            'chegou_atrasado',
            'saiu_mais_cedo',
            'ausente',
            'pendente'
          ])
        )
        && (
          (unresolved && data.absences == null)
          || (!unresolved
            && data.absences is int
            && data.absences >= 0
            && data.absences <= data.lessonCount)
        );
    }

    function isValidSession(data) {
      let requiredFields = [
        'schemaVersion',
        'startsAt',
        'endsAt',
        'lessonCount',
        'callCount',
        'firstPing',
        'secondPing',
        'attendanceStatus',
        'absences',
        'calendarStatus',
        'createdAt',
        'updatedAt'
      ];
      let allowedFields = requiredFields.concat(['assessmentTitle']);
      return data.keys().hasAll(requiredFields)
        && data.keys().hasOnly(allowedFields)
        && data.schemaVersion == 1
        && data.startsAt is timestamp
        && data.endsAt is timestamp
        && data.startsAt < data.endsAt
        && hasValidConfiguration(data)
        && data.calendarStatus in ['scheduled', 'cancelled', 'holiday', 'no_call', 'makeup']
        && (!data.keys().hasAny(['assessmentTitle'])
          || data.assessmentTitle == null
          || (data.assessmentTitle is string
            && data.assessmentTitle.size() > 0
            && data.assessmentTitle.size() <= 120
            && data.assessmentTitle.matches('^\\S(.*\\S)?$')))
        && isValidPing(data.firstPing)
        && isValidPing(data.secondPing)
        && isValidAttendance(data)
        && hasValidAuditFields(data);
    }

    function isValidAcademicDate(data) {
      let fields = [
        'schemaVersion',
        'title',
        'dueAt',
        'kind',
        'source',
        'sourceId',
        'createdAt',
        'updatedAt'
      ];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields.concat(['manualOverride']))
        && (!('manualOverride' in data) || data.manualOverride is bool)
        && data.schemaVersion == 1
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.title.matches('^\\S(.*\\S)?$')
        && data.dueAt is timestamp
        && data.kind in ['assignment', 'quiz', 'event', 'assessment']
        && data.source in ['moodle', 'diario', 'manual']
        && data.sourceId is string
        && data.sourceId.matches('^[A-Za-z0-9_-]{1,80}$')
        && hasValidAuditFields(data);
    }

    function isValidTeachingPlan(data) {
      let fields = [
        'schemaVersion',
        'source',
        'sourceId',
        'confidence',
        'planJson',
        'contentHash',
        'collectedAt',
        'createdAt',
        'updatedAt'
      ];
      return hasExactFields(data, fields)
        && data.schemaVersion == 1
        && data.source == 'ufmg_diario'
        && data.sourceId is string
        && data.sourceId.matches('^[1-9][0-9]{0,9}$')
        && data.confidence == 'authoritative'
        && data.planJson is string
        && data.planJson.size() <= 750000
        && data.contentHash is string
        && data.contentHash.matches('^[0-9a-f]{64}$')
        && data.collectedAt is timestamp
        && hasValidAuditFields(data);
    }

    function isValidMaterialCatalog(data) {
      let fields = [
        'schemaVersion',
        'term',
        'status',
        'moodleCourseId',
        'candidateCount',
        'metaturmaCandidateCount',
        'materialsJson',
        'contentHash',
        'createdAt',
        'updatedAt'
      ];
      let matched = data.status in ['found', 'empty'];
      return hasExactFields(data, fields)
        && data.schemaVersion == 1
        && data.term is string
        && data.term.matches('^20[2-9][0-9]-[12]$')
        && data.status in ['found', 'empty', 'unmatched', 'ambiguous']
        && (data.moodleCourseId == null
          || (data.moodleCourseId is string
            && data.moodleCourseId.matches('^[1-9][0-9]{0,9}$')))
        && matched == (data.moodleCourseId != null)
        && data.candidateCount is int
        && data.candidateCount >= 0
        && data.candidateCount <= 500
        && (data.status == 'found') == (data.candidateCount > 0)
        && data.metaturmaCandidateCount is int
        && data.metaturmaCandidateCount >= 0
        && data.metaturmaCandidateCount <= data.candidateCount
        && data.materialsJson is string
        && data.materialsJson.size() <= 750000
        && data.contentHash is string
        && data.contentHash.matches('^[0-9a-f]{64}$')
        && hasValidAuditFields(data);
    }

    match /users/{userId}/courses/{courseId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && isValidCourse(request.resource.data);
      allow update: if owns(userId)
        && isValidCourse(request.resource.data)
        && preservesAuditFields();

      match /meetings/{meetingId} {
        allow read, delete: if owns(userId);
        allow create: if owns(userId)
          && exists(/databases/$(database)/documents/users/$(userId)/courses/$(courseId))
          && isValidMeeting(request.resource.data);
        allow update: if owns(userId)
          && isValidMeeting(request.resource.data)
          && preservesAuditFields();
      }

      match /sessions/{sessionId} {
        allow read, delete: if owns(userId);
        allow create: if owns(userId)
          && exists(/databases/$(database)/documents/users/$(userId)/courses/$(courseId))
          && isValidSession(request.resource.data);
        allow update: if owns(userId)
          && isValidSession(request.resource.data)
          && preservesAuditFields();
      }

      match /academicDates/{dateId} {
        allow read, delete: if owns(userId);
        allow create: if owns(userId)
          && exists(/databases/$(database)/documents/users/$(userId)/courses/$(courseId))
          && isValidAcademicDate(request.resource.data)
          && dateId == request.resource.data.source + '-' + request.resource.data.sourceId;
        allow update: if owns(userId)
          && isValidAcademicDate(request.resource.data)
          && dateId == request.resource.data.source + '-' + request.resource.data.sourceId
          && preservesAuditFields();
      }

      match /materialCatalog/{catalogId} {
        allow read, delete: if owns(userId);
        allow create: if owns(userId)
          && catalogId == 'current'
          && exists(/databases/$(database)/documents/users/$(userId)/courses/$(courseId))
          && isValidMaterialCatalog(request.resource.data);
        allow update: if owns(userId)
          && catalogId == 'current'
          && isValidMaterialCatalog(request.resource.data)
          && preservesAuditFields();
      }

      match /activitySnapshots/{snapshotId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && snapshotId == 'current'
          && exists(/databases/$(database)/documents/users/$(userId)/courses/$(courseId))
          && hasExactFields(request.resource.data, ['schemaVersion','snapshotJson','contentHash','updatedAt'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.snapshotJson is string
          && request.resource.data.snapshotJson.size() <= 750000
          && request.resource.data.contentHash is string
          && request.resource.data.contentHash.matches('^[0-9a-f]{64}$')
          && request.resource.data.updatedAt is timestamp;
      }

      match /teachingPlans/{planId} {
        allow read, delete: if owns(userId);
        allow create: if owns(userId)
          && planId == 'current'
          && exists(/databases/$(database)/documents/users/$(userId)/courses/$(courseId))
          && isValidTeachingPlan(request.resource.data);
        allow update: if owns(userId)
          && planId == 'current'
          && isValidTeachingPlan(request.resource.data)
          && preservesAuditFields();
      }
    }

    match /users/{userId}/courses/{courseId}/syncState/{sourceId} {
      allow get: if owns(userId) && sourceId in ['plan', 'activities', 'planPreference'];
      allow list: if owns(userId);
      allow create, update: if owns(userId) && sourceId in ['plan', 'activities', 'planPreference']
        && hasExactFields(request.resource.data, ['stateJson'])
        && request.resource.data.stateJson is string
        && request.resource.data.stateJson.size() <= 64000;
      allow delete: if owns(userId);
    }

    match /users/{userId}/syncJobs/{jobId} {
      allow get: if owns(userId) && jobId == 'current';
      allow create, update: if owns(userId) && jobId == 'current'
        && hasExactFields(request.resource.data, ['stateJson'])
        && request.resource.data.stateJson is string
        && request.resource.data.stateJson.size() <= 750000;
    }

    match /users/{userId}/syncProgress/{progressId} {
      allow get: if owns(userId) && progressId == 'current';
      allow create, update: if owns(userId) && progressId == 'current'
        && hasExactFields(request.resource.data, [
          'operationId', 'status', 'stage', 'completed', 'reviewRequired',
          'failureCode', 'startedAt', 'updatedAt'
        ])
        && request.resource.data.operationId is string
        && request.resource.data.operationId.matches('^[A-Za-z0-9_-]{8,80}$')
        && request.resource.data.status in ['running', 'succeeded', 'partial', 'failed']
        && request.resource.data.stage in ['siga', 'moodle', 'plans', 'completed']
        && request.resource.data.completed is int
        && request.resource.data.completed >= 0 && request.resource.data.completed <= 3
        && request.resource.data.reviewRequired is int
        && request.resource.data.reviewRequired >= 0 && request.resource.data.reviewRequired <= 50
        && request.resource.data.failureCode is string && request.resource.data.failureCode.size() <= 80
        && request.resource.data.startedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt >= request.resource.data.startedAt;
    }

    match /users/{userId}/logs/{logId} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && isValidOperationalLog(request.resource.data);
      allow update: if false;
      allow delete: if owns(userId)
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt <= request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
