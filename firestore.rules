rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasExactFields(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function hasValidAuditFields(data) {
      return data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt;
    }

    function preservesAuditFields() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt;
    }

    function hasValidConfiguration(data) {
      return data.lessonCount is int
        && data.lessonCount in [1, 2, 4]
        && data.callCount is int
        && data.callCount in [1, 2]
        && !(data.lessonCount == 1 && data.callCount == 2);
    }

    function isNullableString(value, maxLength) {
      return value == null
        || (value is string && value.size() <= maxLength);
    }

    function isValidOperationalLog(data) {
      let fields = [
        'schemaVersion',
        'occurredAt',
        'expiresAt',
        'level',
        'event',
        'entryPoint',
        'platform',
        'correlationId',
        'operation',
        'outcome',
        'durationMs',
        'errorType',
        'errorCode',
        'errorMessage',
        'errorDetails',
        'fatal'
      ];
      return hasExactFields(data, fields)
        && data.schemaVersion == 1
        && data.occurredAt is timestamp
        && data.occurredAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > data.occurredAt
        && data.expiresAt <= data.occurredAt + duration.value(31, 'd')
        && data.level in ['info', 'error']
        && data.event is string
        && data.event.size() >= 1
        && data.event.size() <= 80
        && data.entryPoint == 'client'
        && data.platform in ['web', 'android']
        && data.correlationId is string
        && data.correlationId.size() >= 1
        && data.correlationId.size() <= 128
        && isNullableString(data.operation, 80)
        && isNullableString(data.outcome, 24)
        && (data.durationMs == null
          || (data.durationMs is int && data.durationMs >= 0))
        && isNullableString(data.errorType, 120)
        && isNullableString(data.errorCode, 120)
        && isNullableString(data.errorMessage, 500)
        && isNullableString(data.errorDetails, 500)
        && data.fatal is bool;
    }

    function isValidCourse(data) {
      let legacyFields = [
        'schemaVersion',
        'code',
        'name',
        'workload',
        'term',
        'createdAt',
        'updatedAt'
      ];
      let datedFields = legacyFields.concat(['startsOn', 'endsOn']);
      let startsOn = data.get('startsOn', null);
      let endsOn = data.get('endsOn', null);
      return (hasExactFields(data, legacyFields) || hasExactFields(data, datedFields))
        && data.schemaVersion == 1
        && data.code is string
        && data.code.size() >= 1
        && data.code.size() <= 32
        && data.code.matches('^\\S(.*\\S)?$')
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 160
        && data.name.matches('^\\S(.*\\S)?$')
        && data.workload is int
        && data.workload > 0
        && data.term is string
        && data.term.matches('^[0-9]{4}-[12]$')
        && ((startsOn == null && endsOn == null)
          || (startsOn is timestamp && endsOn is timestamp && startsOn <= endsOn))
        && hasValidAuditFields(data);
    }

    function isValidMeeting(data) {
      let fields = [
        'schemaVersion',
        'weekday',
        'startMinutes',
        'endMinutes',
        'lessonCount',
        'callCount',
        'createdAt',
        'updatedAt'
      ];
      return hasExactFields(data, fields)
        && data.schemaVersion == 1
        && data.weekday is int
        && data.weekday >= 1
        && data.weekday <= 7
        && data.startMinutes is int
        && data.startMinutes >= 0
        && data.endMinutes is int
        && data.endMinutes <= 1440
        && data.startMinutes < data.endMinutes
        && hasValidConfiguration(data)
        && hasValidAuditFields(data);
    }

    function isValidPing(value) {
      return value == null
        || (value is string && value in ['no_campus', 'fora', 'indisponivel']);
    }

    function isValidAttendance(data) {
      let status = data.attendanceStatus;
      let unresolved = status == null || status == 'pendente';
      return (
          status == null
          || (status is string && status in [
            'presente',
            'chegou_atrasado',
            'saiu_mais_cedo',
            'ausente',
            'pendente'
          ])
        )
        && (
          (unresolved && data.absences == null)
          || (!unresolved
            && data.absences is int
            && data.absences >= 0
            && data.absences <= data.lessonCount)
        );
    }

    function isValidSession(data) {
      let fields = [
        'schemaVersion',
        'startsAt',
        'endsAt',
        'lessonCount',
        'callCount',
        'firstPing',
        'secondPing',
        'attendanceStatus',
        'absences',
        'calendarStatus',
        'createdAt',
        'updatedAt'
      ];
      return hasExactFields(data, fields)
        && data.schemaVersion == 1
        && data.startsAt is timestamp
        && data.endsAt is timestamp
        && data.startsAt < data.endsAt
        && hasValidConfiguration(data)
        && data.calendarStatus in ['scheduled', 'cancelled', 'holiday', 'makeup']
        && isValidPing(data.firstPing)
        && isValidPing(data.secondPing)
        && isValidAttendance(data)
        && hasValidAuditFields(data);
    }

    match /users/{userId}/courses/{courseId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && isValidCourse(request.resource.data);
      allow update: if owns(userId)
        && isValidCourse(request.resource.data)
        && preservesAuditFields();

      match /meetings/{meetingId} {
        allow read, delete: if owns(userId);
        allow create: if owns(userId)
          && exists(/databases/$(database)/documents/users/$(userId)/courses/$(courseId))
          && isValidMeeting(request.resource.data);
        allow update: if owns(userId)
          && isValidMeeting(request.resource.data)
          && preservesAuditFields();
      }

      match /sessions/{sessionId} {
        allow read, delete: if owns(userId);
        allow create: if owns(userId)
          && exists(/databases/$(database)/documents/users/$(userId)/courses/$(courseId))
          && isValidSession(request.resource.data);
        allow update: if owns(userId)
          && isValidSession(request.resource.data)
          && preservesAuditFields();
      }
    }

    match /users/{userId}/logs/{logId} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && isValidOperationalLog(request.resource.data);
      allow update: if false;
      allow delete: if owns(userId)
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt <= request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
