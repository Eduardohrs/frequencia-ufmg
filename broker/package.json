{
  "name": "frequencia-ufmg-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:coverage && npm run deploy:dry-run",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "5.20261001.1",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22"
  }
}
