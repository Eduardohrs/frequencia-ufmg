{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frequencia-ufmg-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "frequencia-ufmg-eduardo",
    "FIREBASE_PROJECT_NUMBER": "932945721608",
    "ALLOWED_ORIGINS": "https://frequencia-ufmg-eduardo.web.app,https://frequencia-ufmg-eduardo.firebaseapp.com,http://localhost:5000,http://localhost:8080",
    "TOKEN_VERIFICATION_TIMEOUT_MS": "5000",
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
